{
  "appId": "ca.academie.ophtalmo",
  "appName": "Ocelle",
  "webDir": "site",
  "loggingBehavior": "debug",
  "server": {
    "iosScheme": "capacitor",
    "hostname": "localhost"
  },
  "ios": {
    "scheme": "App",
    "contentInset": "never",
    "allowsLinkPreview": false,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#0A2547",
      "showSpinner": false
    }
  }
}
